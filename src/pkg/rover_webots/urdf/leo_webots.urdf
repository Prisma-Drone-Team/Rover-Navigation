    <webots>
        <!-- <plugin type="rover_webots.diff_drive_plugin.DiffDrivePlugin"> -->
        <plugin type="rover_webots.absolute_odom_plugin.AbsoluteOdomPlugin">
            <namespace>ROBOT_NAME</namespace>
        </plugin>
        <!-- <plugin type="rover_webots.differential_plugin.DifferentialPlugin" /> -->
        <device reference="d435_depth" type="RangeFinder">
            <ros>
                <frameName>ROBOT_NAME/camera_depth_frame</frameName>
                <alwaysOn>true</alwaysOn>
            </ros>
        </device>
        <device reference="d435_color" type="Camera">

  <gazebo reference="livox">
    <sensor name="laser_livox" type="gpu_lidar">
      <ignition_frame_id>robot1/base_link</ignition_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <visualize>True</visualize>
      <update_rate>10</update_rate>
      <!-- This ray plgin is only for visualization. -->
      <!--plugin filename="libros2_livox.so" name="livox_plugin"-->
        <lidar>
          <scan>
            <horizontal>
              <samples>100</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28318</max_angle>
            </horizontal>
            <vertical>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-0.12601266555555554</min_angle>
              <max_angle>0.9637699988888888</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>200.0</max>
            <resolution>0.002</resolution>
          </range>
          <!-- <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise> -->
        </lidar>
        <!--visualize>False</visualize-->
        <samples>24000</samples>
        <downsample>1</downsample>
        <csv_file_name>package://gz_migration/scan_mode/mid360.csv</csv_file_name>
        <!--ros_topic>${ros_topic}</ros_topic-->
        <topic>/robot1/scan</topic>
      <!--/plugin-->
    </sensor>
  </gazebo>

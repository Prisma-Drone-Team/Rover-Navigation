    <child link="rocker_L_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100.0" lower="-0.5" upper="0.5" velocity="10.0"/>
    <dynamics damping="0.1" friction="1.0"/>
  </joint>
  <joint name="rocker_R_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.00263 -0.14167 -0.04731"/>
    <parent link="base_link"/>
    <child link="rocker_R_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100.0" lower="-0.5" upper="0.5" velocity="10.0"/>
    <dynamics damping="0.1" friction="1.0"/>
    <!-- <mimic joint="rocker_L_joint"/> -->
  </joint>
  <joint name="wheel_FL_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.15256 -0.08214 -0.08802"/>
    <parent link="rocker_L_link"/>
    <child link="wheel_FL_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="2.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.3125"/>
  </joint>
  <joint name="wheel_RL_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.15256 -0.08214 -0.08802"/>
    <parent link="rocker_L_link"/>
    <child link="wheel_RL_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="2.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.3125"/>
  </joint>
  <joint name="wheel_FR_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.15256 -0.08214 -0.08802"/>
    <parent link="rocker_R_link"/>
    <child link="wheel_FR_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.3125"/>
  </joint>
  <joint name="wheel_RR_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.15256 -0.08214 -0.08802"/>
    <parent link="rocker_R_link"/>
    <child link="wheel_RR_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.3125"/>
  </joint>
  <joint name="antenna_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0052 0.056 -0.0065"/>
    <parent link="base_link"/>
    <child link="antenna_link"/>
  </joint>
  <joint name="imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0628 -0.0314 -0.0393"/>
    <parent link="base_link"/>
    <child link="imu_frame"/>
  </joint>
  <!--lidar joint-->
  <!--joint name="livox_base_joint" type="fixed">
        <parent link="${link_prefix}base_link"/>
        <child link="{name}_base"/>
        <origin rpy="0 0 1.5707"
                xyz="0.0 0.4 0.3057"/>
    </joint-->

  <!-- base ODE properties -->
  <gazebo reference="base_footprint">
    <!-- <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.3</mu>
            <mu2>0.3</mu2>
          </ode>
          <bullet>
            <friction>0.3</friction>
            <friction2>0.3</friction2>
            <rolling_friction>0.1</rolling_friction>
          </bullet>
        </friction>
      </surface>
    </collision> -->
      <kp>1e6</kp>
      <kd>1.0</kd>
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
      <minDepth>0.003</minDepth>
  </gazebo>
  <gazebo reference="base_link">
    <!-- <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.3</mu>
            <mu2>0.3</mu2>
          </ode>
          <bullet>
            <friction>0.3</friction>
            <friction2>0.3</friction2>
            <rolling_friction>0.1</rolling_friction>
          </bullet>
        </friction>
      </surface>
    </collision> -->
      <kp>1e6</kp>
      <kd>1.0</kd>
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
      <minDepth>0.003</minDepth>
  </gazebo>
  <!-- rocker ODE properties -->
  <gazebo reference="rocker_L_link">
    <!-- <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.3</mu>
            <mu2>0.3</mu2>
          </ode>
          <bullet>
            <friction>0.3</friction>
            <friction2>0.3</friction2>
            <rolling_friction>0.1</rolling_friction>
          </bullet>
        </friction>
      </surface>
    </collision> -->
      <kp>1e6</kp>
      <kd>1.0</kd>
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
      <minDepth>0.003</minDepth>
  </gazebo>
  <gazebo reference="rocker_R_link">
    <!-- <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.3</mu>
            <mu2>0.3</mu2>
          </ode>
          <bullet>
            <friction>0.3</friction>
            <friction2>0.3</friction2>
            <rolling_friction>0.1</rolling_friction>
          </bullet>
        </friction>
      </surface>
    </collision> -->
      <kp>1e6</kp>
      <kd>1.0</kd>
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
      <minDepth>0.003</minDepth>
  </gazebo>
  <!-- wheel ODE properties -->
<xacro:macro name="gazebo_wheel_contact">

  <gazebo reference="wheel_FL_link">
        <!-- <mu1 value="1.0"/>
        <mu2 value="1.0"/>
        <kp value="1e15"/>
        <kd value="1e13"/>
        <fdir1>1 0 0</fdir1>
        <minDepth>0.003</minDepth> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>3.0</mu>
            <mu2>1.0</mu2>
          </ode>
          <bullet>
            <friction>3.0</friction>
            <friction2>1.0</friction2>
            <rolling_friction>0.05</rolling_friction> <!-- utile per stabilità -->
          </bullet>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="wheel_FR_link">
        <!-- <mu1 value="1.0"/>
        <mu2 value="1.0"/>
        <kp value="1e15"/>
        <kd value="1e13"/>
        <fdir1>1 0 0</fdir1>
        <minDepth>0.003</minDepth> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>3.0</mu>
            <mu2>1.0</mu2>
          </ode>
          <bullet>
            <friction>3.0</friction>
            <friction2>1.0</friction2>
            <rolling_friction>0.05</rolling_friction> <!-- utile per stabilità -->
          </bullet>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="wheel_RL_link">
        <!-- <mu1 value="1.0"/>
        <mu2 value="1.0"/>
        <kp value="1e15"/>
        <kd value="1e13"/>
        <fdir1>1 0 0</fdir1>
        <minDepth>0.003</minDepth> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>3.0</mu>
            <mu2>1.0</mu2>
          </ode>
          <bullet>
            <friction>3.0</friction>
            <friction2>1.0</friction2>
            <rolling_friction>0.05</rolling_friction> <!-- utile per stabilità -->
          </bullet>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="wheel_RR_link">
        <!-- <mu1 value="1.0"/>
        <mu2 value="1.0"/>
        <kp value="1e15"/>
        <kd value="1e13"/>
        <fdir1>1 0 0</fdir1>
        <minDepth>0.003</minDepth> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>3.0</mu>
            <mu2>1.0</mu2>
          </ode>
          <bullet>
            <friction>3.0</friction>
            <friction2>1.0</friction2>
            <rolling_friction>0.05</rolling_friction> <!-- utile per stabilità -->
          </bullet>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="collision_f_l">
      <mu1 value="0.1"/>
      <mu2 value="0.1"/>
      <kp value="10000000.0"/>
      <kd value="100.0"/>
      <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="collision_f_r">
      <mu1 value="0.1"/>
      <mu2 value="0.1"/>
      <kp value="10000000.0"/>
      <kd value="100.0"/>
      <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="collision_b_l">
      <mu1 value="0.1"/>
      <mu2 value="0.1"/>
      <kp value="10000000.0"/>
      <kd value="100.0"/>
      <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="collision_b_r">
      <mu1 value="0.1"/>
      <mu2 value="0.1"/>
      <kp value="10000000.0"/>
      <kd value="100.0"/>
      <minDepth>0.001</minDepth>
  </gazebo>
</xacro:macro>

  <!-- rocker differential -->
  <gazebo>
    <plugin name="leo_gz::DifferentialSystem" filename="libleo_gz_differential_plugin.so">
      <jointA>rocker_L_joint</jointA>
      <jointB>rocker_R_joint</jointB>
      <forceConstant>100.0</forceConstant>
    </plugin>
  </gazebo>
  <gazebo>
      <plugin
        filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
  <!-- <gazebo reference="imu_frame">
    <sensor name="leo_imu_sensor" type="imu">
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu/data_raw</topic>
      <always_on>1</always_on>
      <ignition_frame_id>imu_frame</ignition_frame_id>
    </sensor>
  </gazebo> -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_FL_joint</left_joint>
      <right_joint>wheel_FR_joint</right_joint>
      <left_joint>wheel_RL_joint</left_joint>
      <right_joint>wheel_RR_joint</right_joint>
      <wheel_separation>0.358</wheel_separation>
      <wheel_radius>0.0625</wheel_radius>
      <frame_id></frame_id>  <!--frame custom preso come origine di odom tf-->
      <child_frame_id>robot1/base_footprint</child_frame_id> <!--frame target di odom tf-->
      <odom_publish_frequency></odom_publish_frequency>
      <topic>/robot1/cmd_vel</topic> <!--topic da cui legge cmd_vel-->
      <odom_topic></odom_topic> <!--topic su cui pubblica odom-->
      <tf_topic></tf_topic> <!--topic su cui pubblica tf tra frame_id e child_frame_id-->
      <max_linear_acceleration>2.5</max_linear_acceleration>
      <max_angular_acceleration>3</max_angular_acceleration>
      <min_linear_acceleration>-2.5</min_linear_acceleration>
      <min_angular_acceleration>-3</min_angular_acceleration>
      <!--robot_base_frame>base_link</robot_base_frame>
      <publish_odom>false</publish_odom-->
      <!-- <publish_odom_tf>true</publish_odom_tf> se c'è, la tf tra odom e base_footprint è statica-->
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <publish_nested_model_pose>true</publish_nested_model_pose>
    </plugin>
  </gazebo>

</robot>
